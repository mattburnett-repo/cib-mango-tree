{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "nicegui-docs": {
      "command": "uvx",
      "args": [
        "--from",
        "mcpdoc==0.0.10",
        "--with",
        "mcp[cli]==1.9.4",
        "mcpdoc",
        "--urls",
        "NiceGUI:docs/nicegui.io/llm.txt",
        "--allowed-domains",
        "nicegui.io",
        "--transport",
        "stdio"
      ]
    }
  }
}
